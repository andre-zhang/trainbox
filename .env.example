# Neon Postgres — paste your connection string from the Neon dashboard.
# Also add this in Vercel → Project → Settings → Environment Variables as DATABASE_URL.
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# CARTO basemap tiles now require an API key (https://carto.com/basemaps/apikey/).
# Also add this in Vercel → Project → Settings → Environment Variables as VITE_CARTO_API_KEY.
# Vite inlines VITE_-prefixed vars into the client bundle at build time, so no server proxy is needed.
VITE_CARTO_API_KEY=your-carto-api-key
